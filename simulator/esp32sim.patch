diff --git a/esp32s3/src/board/fh1.rs b/esp32s3/src/board/fh1.rs
new file mode 100644
index 00000000..b8391fde
--- /dev/null
+++ b/esp32s3/src/board/fh1.rs
@@ -0,0 +1,144 @@
+//! The FH1 handheld (github.com/acesso/fh1, hardware/wiring.md): an ST7789 240x320 module turned to
+//! landscape on SPI2 (SCK 18, MOSI 39, CS 38, DC 47, RST 48, backlight PWM 40); I2C0 on SDA 3 / SCL 1 with
+//! two MCP23017 expanders (0x20: the face buttons on GPA0-5 and their LEDs on GPB0-3, low = on; 0x21:
+//! the amplifier enable and the radio's lines), an ES8311 codec (0x18) and a PCF8563 clock (0x51); I2S
+//! to the codec on BCK 14, WS 10, DOUT 12; the stick on ADC GPIO2 (X) and GPIO4 (Y); Menu on GPIO0.
+//! Not modelled: the micro-SD slot (SDMMC), the E28 radio (SPI3), the IMU.
+//! Keys (`press` from the UI, `press NAME` in scripts): a, b, x, y, start, select on MCP #1 GPA0-5, menu on GPIO0.
+//! The stick is two ADC voltages (`adc 2 V`, `adc 4 V`; 1.65 V centred, low = left / up). `lights()` gives the
+//! A, B, X, Y LEDs in the buttons' colours.
+use esp_soc::board::BoardModel;
+use esp_soc::devices::DcsPanel;
+use std::sync::{Arc, Mutex};
+
+pub const PIN_MENU: u8 = 0;
+pub const PIN_LCD_DC: u8 = 47;
+pub const PIN_LCD_RST: u8 = 48;
+pub const PIN_STICK_X: u8 = 2;
+pub const PIN_STICK_Y: u8 = 4;
+pub const LCD_W: usize = 320;
+pub const LCD_H: usize = 240;
+/// The face buttons in MCP #1 GPA0-5 order.
+pub const KEYS: [&str; 6] = ["a", "b", "x", "y", "start", "select"];
+/// The A, B, X, Y buttons' colours (their LEDs on MCP #1 GPB0-3).
+pub const LIGHT_RGB: [[u8; 3]; 4] = [[0xe5, 0x30, 0x2c], [0xf4, 0xc2, 0x1f], [0x2f, 0x6f, 0xe8], [0x2f, 0xb3, 0x6a]];
+
+/// An MCP23017's registers (IOCON.BANK = 0: A and B interleaved) and the levels outside drives on its
+/// pins (`inputs`: bit set = high; the firmware enables pull-ups, so an unpressed button reads high).
+pub struct Mcp23017State { pub regs: [u8; 0x16], pub inputs: [u8; 2], pub writes: u64 }
+impl Default for Mcp23017State {
+    fn default() -> Self { let mut regs = [0u8; 0x16]; regs[0] = 0xff; regs[1] = 0xff; Mcp23017State { regs, inputs: [0xff; 2], writes: 0 } }
+}
+impl Mcp23017State {
+    /// What the GPIO register reads: the outside level on input pins, the latch on output pins.
+    pub fn gpio(&self, port: usize) -> u8 { let dir = self.regs[port]; (self.inputs[port] & dir) | (self.regs[0x14 + port] & !dir) }
+}
+
+/// The I2C side of an MCP23017: a register pointer that advances after each byte (IOCON.SEQOP = 0).
+pub struct Mcp23017 { state: Arc<Mutex<Mcp23017State>>, ptr: u8, first: bool }
+impl Mcp23017 { pub fn new(state: Arc<Mutex<Mcp23017State>>) -> Self { Mcp23017 { state, ptr: 0, first: true } } }
+impl crate::i2c::I2cDevice for Mcp23017 {
+    fn start(&mut self, read: bool) -> bool { if !read { self.first = true; } true }
+    fn write(&mut self, b: u8) -> bool {
+        if self.first { self.ptr = b % 0x16; self.first = false; return true; }
+        let mut s = self.state.lock().unwrap();
+        // Writing GPIOx writes the output latch OLATx.
+        let r = if self.ptr == 0x12 || self.ptr == 0x13 { self.ptr + 2 } else { self.ptr } as usize;
+        s.regs[r] = b; s.writes += 1;
+        self.ptr = (self.ptr + 1) % 0x16;
+        true
+    }
+    fn read(&mut self) -> u8 {
+        let s = self.state.lock().unwrap();
+        let v = match self.ptr { 0x12 => s.gpio(0), 0x13 => s.gpio(1), p => s.regs[p as usize] };
+        self.ptr = (self.ptr + 1) % 0x16;
+        v
+    }
+}
+
+/// The FH1.
+pub struct Fh1 {
+    pub panel: DcsPanel,
+    pub mcp: [Arc<Mutex<Mcp23017State>>; 2],
+    pub gpio_events: u64,
+}
+impl Default for Fh1 { fn default() -> Self { Self::new() } }
+impl Fh1 {
+    pub fn new() -> Self { Fh1 { panel: DcsPanel::st7789(), mcp: Default::default(), gpio_events: 0 } }
+
+    /// The glass, landscape, as the firmware addresses it: logical (x, y) is the controller's column and page
+    /// counters, mapped through MADCTL exactly as the controller wrote them. The module is IPS: without INVON
+    /// it shows every colour inverted. Blank while the panel is off or asleep.
+    pub fn glass(&self) -> Vec<u16> {
+        let p = &self.panel;
+        let mut out = vec![0u16; LCD_W * LCD_H];
+        if !p.on || p.sleeping { return out; }
+        for y in 0..LCD_H {
+            for x in 0..LCD_W {
+                let (mut col, mut row) = (x, y);
+                if p.madctl & 0x20 != 0 { std::mem::swap(&mut col, &mut row); }
+                if p.madctl & 0x40 != 0 { col = p.cols - 1 - col.min(p.cols - 1); }
+                if p.madctl & 0x80 != 0 { row = p.rows - 1 - row.min(p.rows - 1); }
+                if col < p.cols && row < p.rows {
+                    let px = p.gram[row * p.cols + col];
+                    out[y * LCD_W + x] = if p.inverted { px } else { !px };
+                }
+            }
+        }
+        out
+    }
+
+    /// The face buttons' LEDs (A, B, X, Y): on where MCP #1's GPB0-3 are outputs driven low.
+    pub fn leds(&self) -> [bool; 4] {
+        let s = self.mcp[0].lock().unwrap();
+        let mut on = [false; 4];
+        for (i, l) in on.iter_mut().enumerate() { *l = s.regs[1] & (1 << i) == 0 && s.regs[0x15] & (1 << i) == 0; }
+        on
+    }
+}
+impl BoardModel for Fh1 {
+    fn name(&self) -> &'static str { "fh1" }
+    fn gpio_changes(&mut self, changes: &[(u8, bool)]) {
+        for &(pin, level) in changes {
+            self.gpio_events += 1;
+            match pin {
+                PIN_LCD_DC => self.panel.dc = level,
+                PIN_LCD_RST => if !level { self.panel.reset(); },
+                _ => {}
+            }
+        }
+    }
+    fn gpio_events(&self) -> u64 { self.gpio_events }
+    fn spi_tx(&mut self, host: u8, data: &[u8]) { if host == 2 { for &b in data { self.panel.byte(b); } } }
+    fn i2c_devices(&mut self) -> Vec<(u8, u8, Box<dyn crate::i2c::I2cDevice>)> {
+        use crate::i2c::*;
+        vec![
+            (0, 0x20, Box::new(Mcp23017::new(self.mcp[0].clone()))),
+            (0, 0x21, Box::new(Mcp23017::new(self.mcp[1].clone()))),
+            (0, 0x18, Box::new(Reg8Device::new("es8311", &[(0xfd, 0x83), (0xfe, 0x11)]))),
+            // VL set: the clock reports its time as not set.
+            (0, 0x51, Box::new(Reg8Device::new("pcf8563", &[(0x02, 0x80)]))),
+        ]
+    }
+    fn input_levels(&self) -> Vec<(u8, bool)> { vec![(PIN_MENU, true)] }
+    fn named_pin(&self, name: &str) -> Option<u8> { match name { "menu" | "boot" => Some(PIN_MENU), _ => None } }
+    fn key(&mut self, name: &str, down: bool) -> bool {
+        let Some(bit) = KEYS.iter().position(|k| *k == name) else { return false };
+        let mut s = self.mcp[0].lock().unwrap();
+        if down { s.inputs[0] &= !(1 << bit); } else { s.inputs[0] |= 1 << bit; }
+        true
+    }
+    fn lights(&self) -> Vec<[u8; 3]> { self.leds().iter().zip(LIGHT_RGB).map(|(&on, rgb)| if on { rgb } else { [0; 3] }).collect() }
+    fn display(&self) -> Option<(u32, u32, Vec<u16>, u64)> { Some((LCD_W as u32, LCD_H as u32, self.glass(), self.panel.pixels_written)) }
+    fn display_version(&self) -> u64 { self.panel.pixels_written }
+    fn display_frames(&self) -> u64 { self.panel.frames }
+    fn gram(&self) -> Option<(Vec<u16>, usize, usize)> { Some((self.panel.gram.clone(), self.panel.cols, self.panel.rows)) }
+    fn report(&self) -> String {
+        let p = &self.panel;
+        let leds = self.leds();
+        let (m1, m2) = (self.mcp[0].lock().unwrap(), self.mcp[1].lock().unwrap());
+        format!("[emu] fh1: {} RAMWR, {} pixels, madctl={:#x} colmod={:#x} inverted={} on={}; MCP #1 {} writes (IODIR {:02x}{:02x}, OLAT {:02x}{:02x}), LEDs A B X Y {:?}; MCP #2 {} writes (OLAT {:02x}{:02x}); gpio events {}",
+                p.frames, p.pixels_written, p.madctl, p.colmod, p.inverted, p.on, m1.writes, m1.regs[1], m1.regs[0], m1.regs[0x15], m1.regs[0x14],
+                leds, m2.writes, m2.regs[0x15], m2.regs[0x14], self.gpio_events)
+    }
+}
