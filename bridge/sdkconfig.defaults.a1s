# The A1S module's PSRAM (on GPIO 16/17): the sound buffer for 48 kHz stereo lives there. Its builds add this
# file: -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.a1s" (bridge/README.md).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
