# FH1 firmware defaults (ESP-IDF v6.1, ESP32-S3 N16R8)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# 8 MB octal PSRAM in the chip
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Not CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP: it forces 16 static Wi-Fi TX buffers, ~26 KB of internal RAM held
# for good (measured), more than the network's passing use of it.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# RGB panel: keep the scan alive while flash is busy, and resync at the next frame if it slips
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# Bigger caches (Espressif's settings for RGB panels): fewer PSRAM reads competing with the panel
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# Wi-Fi: fewer static receive buffers, to pay for the caches in internal RAM
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# ...and a cap on what it borrows in a burst (each buffer ~1.6 KB of internal RAM): with 32 of each, five
# screenshots took internal RAM down to 120 bytes (470 allocations failed), where task stacks, SD and display DMA
# need it too. TCP windows are 4 segments: 8 send buffers keep the link busy; 16 receive buffers (10 halved the
# upload speed).
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16

# Task statistics for the dev console
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Console on UART0 (the CH340 on the dev board)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Crash dumps to their partition
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Dev console
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# SD card
CONFIG_FATFS_LFN_HEAP=y

# Packaged apps
CONFIG_ELF_LOADER=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y

# LVGL: 16-bit colour, pixel fonts, our own theme
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates through malloc: large blocks go to PSRAM, small ones stay internal
CONFIG_LV_USE_CUSTOM_MALLOC=y
# Speed: -O2 for the whole firmware
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# Network time: two servers (Brazil first)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Firmware updates: a new image that fails before marking itself valid is rolled back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# mbedTLS allocates in PSRAM (a TLS session takes tens of KB) so internal RAM stays free.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Bluetooth LE for the extension boards (fh1_bridge): NimBLE as a central only, two connections, its memory in
# PSRAM. It only starts while the device bridge0 is enabled.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# The controller's code in flash (in PSRAM here), not in IRAM: ~20 KB of internal RAM kept free even while
# Bluetooth is off. Bluetooth can miss a beat while the flash is being erased.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
# Sized for a scan and two bridges at once (FH1_BRIDGES_LINKED): the controller's and NimBLE's pools take
# internal RAM.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=20
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=4
